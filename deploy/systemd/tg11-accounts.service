[Unit]
Description=TG11 Accounts (OpenID Connect identity provider)
After=network.target

[Service]
User=tg11accounts
Group=tg11accounts
WorkingDirectory=/var/www/TG11Accounts
EnvironmentFile=/var/www/TG11Accounts/.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/var/www/TG11Accounts/.venv/bin/uvicorn tg11.web:app --host 127.1.0.5 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/TG11Accounts/data
ProtectHome=true

[Install]
WantedBy=multi-user.target

# TG11 Accounts (accounts.tg11.org) configuration
TG11_ENV=production
TG11_SECRET_KEY=change-me                 # signs session cookies (>= 32 random chars)
TG11_ISSUER=https://accounts.tg11.org     # public URL; becomes the `iss` claim (no trailing slash)
TG11_SITE_NAME=TG11 Account
TG11_DATA_DIR=/var/www/TG11Accounts/data  # SQLite db (accounts.sqlite3) + signing keys live in the db
TG11_DATABASE_URL=                        # optional: postgresql+psycopg://...
TG11_ALLOWED_HOSTS=accounts.tg11.org,127.1.0.5,localhost
TG11_ALLOW_REGISTRATION=true
TG11_REQUIRE_EMAIL_VERIFICATION=false     # set true once SMTP is confirmed working
TG11_COOKIE_SECURE=true
TG11_ACCESS_TOKEN_TTL=3600
TG11_ID_TOKEN_TTL=3600
TG11_REFRESH_TOKEN_TTL=2592000
SMTP_HOST=mail.tg11.org
SMTP_PORT=587
SMTP_USER=noreply@tg11.org
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=TG11 Accounts <noreply@tg11.org>

# TG11 Accounts (accounts.tg11.org) configuration
TG11_ENV=production
# signs session cookies (>= 32 random chars)
TG11_SECRET_KEY=change-me
# public URL; becomes the `iss` claim (no trailing slash)
TG11_ISSUER=https://accounts.tg11.org
TG11_SITE_NAME=TG11 Account
# SQLite db (accounts.sqlite3) + signing keys live in the db
TG11_DATA_DIR=/var/www/TG11Accounts/data
# optional: postgresql+psycopg://...
TG11_DATABASE_URL=
TG11_ALLOWED_HOSTS=accounts.tg11.org,127.1.0.5,localhost
TG11_ALLOW_REGISTRATION=true
# set true once SMTP is confirmed working
TG11_REQUIRE_EMAIL_VERIFICATION=false
TG11_COOKIE_SECURE=true
TG11_ACCESS_TOKEN_TTL=3600
TG11_ID_TOKEN_TTL=3600
TG11_REFRESH_TOKEN_TTL=2592000
SMTP_HOST=mail.tg11.org
SMTP_PORT=587
SMTP_USER=noreply@tg11.org
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=TG11 Accounts <noreply@tg11.org>
# AES-256-GCM key for the AI key vault (generate: python -m tg11.crypto)
TG11_VAULT_KEY=
# uploaded avatars/headers (default: <data>/media)
TG11_MEDIA_DIR=
# SMS verification via Twilio (leave empty until you have a number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Payments - Stripe (cards, Link, Apple/Google Pay). Others are listed as planned until configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
